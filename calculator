choices={'addition': '+', 'subtraction': '-', 'multiplication': '*', 'division': '//'}
while True:
    operator = input("Enter the operator you want to use(addition/subtraction/multiplication/division): ").lower()
    if operator not in choices:
        print("please enter the valid operator!")
    else:
        num1 = float(input("Enter the first number: "))
        num2 = float(input("Enter the second number: "))
        
        break

def calculate(num1, num2, operator):
    if operator == 'addition':
        return num1 + num2
    elif operator == 'subtraction':
        return num1 - num2
    elif operator == 'multiplication':
        return num1 * num2
    elif operator == 'division':
        if num2 != 0:
            return num1 / num2
        else:
            return "Error: Division by zero is not allowed."    
result = calculate(num1, num2, operator)
print(f"The result of {num1} {choices[operator]} {num2} is: {result}")      